cat > .gitignore <<'EOF'
# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET
**/bin/
**/obj/
**/TestResults/
**/artifacts/
*.nupkg
*.snupkg

# Node.js / Angular
**/node_modules/
**/dist/
**/coverage/
**/.angular/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Secrets and environment variables
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.*.json
secrets.json
*.pfx
*.p12

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Local database files
*.db
*.sqlite
*.sqlite3
EOF