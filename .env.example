# Copy this file to .env and fill the values locally. Do not commit .env.
SUPABASE_CONNECTION_STRING="Host=YOUR_POOLER_HOST;Port=5432;Database=postgres;Username=YOUR_POOLER_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LOOKUP_HMAC_KEY=replace-with-at-least-32-random-characters
